# ApplyMate Environment Configuration
PORT=5001
SECRET_KEY=applymate-super-secret-key-change-in-prod-2026
JWT_SECRET_KEY=applymate-jwt-token-secret-key-2026
JWT_EXPIRATION_HOURS=72

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=postgresql://localhost:5432/applymate
# Fallback for lightweight local testing:
# DATABASE_URL=sqlite:///applymate.db

# LLM Provider Configuration (gemini | openai | mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

